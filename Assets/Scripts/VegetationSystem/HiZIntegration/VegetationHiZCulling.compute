#pragma kernel CullInstances
#pragma kernel CullInstancesWithHiZ
#pragma kernel ClassifyVisibleInstances

// Platform compatibility keyword for reversed Z.
#pragma multi_compile _ HIZ_REVERSED_Z

#include <UnityShaderVariables.cginc>

struct GrassInstanceData
{
    float3 position;
    float rotationY;
    float2 scale;
};

StructuredBuffer<GrassInstanceData> _AllInstances;
StructuredBuffer<GrassInstanceData> _CulledVisibleInstancesInput;
AppendStructuredBuffer<GrassInstanceData> _CulledVisibleInstances;
AppendStructuredBuffer<GrassInstanceData> _VisibleInstances;
RWStructuredBuffer<uint> _VisibleInstanceCount;

RWStructuredBuffer<uint> _ArgsBuffer;

float4 _FrustumPlanes[6];
float2 _LodDistanceRange;
float3 _CameraPosition;

struct ChunkInfo
{
    uint guid;
    float3 center;
    float3 extents;
    uint startIndex;
    uint count;
};

StructuredBuffer<ChunkInfo> _VisibleChunkInfos;
uint _ChunkCount;

Texture2D<float> _HizDepthTexture;
float4 _HizTextureSize;
float4x4 _HiZ_VP;
float _HizWorldSpaceBias;
float3 _Extents;
float3 _BoundsCenterOS;
float2 _CameraNearFar;
bool _EnableHiZCulling;
int _HizReversedZ;

#if defined(_DEBUG_HIZ)
RWStructuredBuffer<uint> _DebugCulledCount;
RWStructuredBuffer<uint> _DebugTestedCount;
#endif

float CompareDepth(float d1, float d2)
{
    return (_HizReversedZ != 0) ? min(d1, d2) : max(d1, d2);
}

float WorldSpaceToNdcDepthBias(float viewSpaceZ, float worldSpaceBias)
{
    float nearPlane = _CameraNearFar.x;
    float farPlane = _CameraNearFar.y;

    viewSpaceZ = max(viewSpaceZ, nearPlane * 0.5f);

    float denom = farPlane - nearPlane;
    if (denom <= 0.0001f)
    {
        return worldSpaceBias * 0.001f;
    }

    float depthDerivative = (farPlane * nearPlane) / (denom * viewSpaceZ * viewSpaceZ);
    float clampedDerivative = saturate(depthDerivative * 1000.0f) * 0.01f;
    return worldSpaceBias * clampedDerivative + 0.001f;
}

bool FrustumTest(float3 center, float3 extents)
{
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 plane = _FrustumPlanes[i];
        float3 normalAbs = abs(plane.xyz);
        float radius = dot(normalAbs, extents);
        float distanceToPlane = dot(plane.xyz, center) + plane.w;
        if (distanceToPlane + radius < 0.0f)
        {
            return false;
        }
    }

    return true;
}

int CeilToPowerOfTwo(int x)
{
    if (x <= 1)
    {
        return 1;
    }

    x--;
    x |= x >> 1;
    x |= x >> 2;
    x |= x >> 4;
    x |= x >> 8;
    x |= x >> 16;
    return x + 1;
}

int GetExpectedTexelSize(float2 boundsOffset, float2 boundsSize)
{
    float size = max(boundsSize.x, boundsSize.y);
    if (size <= 0.0001f)
    {
        return 1;
    }

    int targetTexelCount = CeilToPowerOfTwo((int)(1.0f / size));
    float targetTexelSize = 1.0f / targetTexelCount;

    int coordLeft = floor(boundsOffset.x / targetTexelSize);
    int coordRight = floor((boundsOffset.x + boundsSize.x) / targetTexelSize);
    int coordDown = floor(boundsOffset.y / targetTexelSize);
    int coordUp = floor((boundsOffset.y + boundsSize.y) / targetTexelSize);

    if (coordRight - coordLeft > 1 || coordUp - coordDown > 1)
    {
        targetTexelCount = max(1, targetTexelCount >> 1);
    }

    return targetTexelCount;
}

int CalculateMipmapLevel(float2 boundsOffset, float2 boundsSize)
{
    int baseWidth = (int)_HizTextureSize.x;
    int baseHeight = (int)_HizTextureSize.y;
    int maxMip = (int)_HizTextureSize.z - 1;

    int mipmapPower2 = (int)log2(min(baseWidth, baseHeight));
    int expectedPower2 = (int)log2(GetExpectedTexelSize(boundsOffset, boundsSize));
    return clamp(mipmapPower2 - expectedPower2, 0, maxMip);
}

void GetMipmapInfo(int mipmapLevel, out int2 startCoord, out int2 size)
{
    int baseWidth = (int)_HizTextureSize.x;
    int baseHeight = (int)_HizTextureSize.y;

    if (mipmapLevel == 0)
    {
        startCoord = int2(0, 0);
        size = int2(baseWidth, baseHeight);
        return;
    }

    size.x = baseWidth >> mipmapLevel;
    size.y = baseHeight >> mipmapLevel;

    int xOffset = baseWidth;
    for (int i = 1; i < mipmapLevel; i++)
    {
        xOffset += max(1, baseWidth >> i);
    }

    startCoord = int2(xOffset, 0);
}

float SampleMipmap(float2 uv, int mipmapLevel)
{
    int2 startCoord;
    int2 mipSize;
    GetMipmapInfo(mipmapLevel, startCoord, mipSize);

    int2 coord = int2(uv * float2(mipSize));
    coord = clamp(coord, int2(0, 0), mipSize - 1);
    return _HizDepthTexture.Load(int3(startCoord + coord, 0));
}

float GatherConservativeOccluderDepth(float2 minUV, float2 maxUV, int mipmapLevel)
{
    const float2 samplePoints[9] =
    {
        float2(0.0f, 0.0f), float2(0.5f, 0.0f), float2(1.0f, 0.0f),
        float2(0.0f, 0.5f), float2(0.5f, 0.5f), float2(1.0f, 0.5f),
        float2(0.0f, 1.0f), float2(0.5f, 1.0f), float2(1.0f, 1.0f)
    };

    float occluderDepth = (_HizReversedZ != 0) ? 1.0f : 0.0f;

    [unroll]
    for (int i = 0; i < 9; i++)
    {
        float2 uv = lerp(minUV, maxUV, samplePoints[i]);
        float depth = SampleMipmap(uv, mipmapLevel);
        occluderDepth = CompareDepth(occluderDepth, depth);
    }

    return occluderDepth;
}

bool ShouldRunMip0Refine(float2 boundsSize, int mipmapLevel)
{
    int baseWidth = (int)_HizTextureSize.x;
    int baseHeight = (int)_HizTextureSize.y;
    float2 spanTexels = boundsSize * float2(baseWidth, baseHeight);
    float maxSpan = max(spanTexels.x, spanTexels.y);
    float minSpan = min(spanTexels.x, spanTexels.y);

    // Only refine expensive false-positive-prone cases:
    // large-enough projected bounds, coarse mip usage, or elongated silhouettes.
    return mipmapLevel > 0 || maxSpan >= 6.0f || (maxSpan >= 4.0f && minSpan <= 2.0f);
}

bool HasVisibleSampleAtMip0(float2 minUV, float2 maxUV, float objectMinDepth, float objectMaxDepth, float ndcDepthBias)
{
    const float2 samplePoints[15] =
    {
        float2(0.0f, 0.0f), float2(0.25f, 0.0f), float2(0.5f, 0.0f), float2(0.75f, 0.0f), float2(1.0f, 0.0f),
        float2(0.0f, 0.5f), float2(0.25f, 0.5f), float2(0.5f, 0.5f), float2(0.75f, 0.5f), float2(1.0f, 0.5f),
        float2(0.0f, 1.0f), float2(0.25f, 1.0f), float2(0.5f, 1.0f), float2(0.75f, 1.0f), float2(1.0f, 1.0f)
    };

    [unroll]
    for (int i = 0; i < 15; i++)
    {
        float2 uv = lerp(minUV, maxUV, samplePoints[i]);
        float sceneDepth = SampleMipmap(uv, 0);

        if (_HizReversedZ != 0)
        {
            if ((objectMaxDepth + ndcDepthBias) >= sceneDepth)
            {
                return true;
            }
        }
        else
        {
            if ((objectMinDepth - ndcDepthBias) <= sceneDepth)
            {
                return true;
            }
        }
    }

    return false;
}

bool HiZOcclusionTest(float3 center, float3 extents)
{
    if (!_EnableHiZCulling)
    {
        return false;
    }

    const int3 offsets[8] =
    {
        int3(1, 1, 1), int3(1, 1, -1), int3(1, -1, 1), int3(1, -1, -1),
        int3(-1, 1, 1), int3(-1, 1, -1), int3(-1, -1, 1), int3(-1, -1, -1)
    };

    float2 minUV = float2(1.#INF, 1.#INF);
    float2 maxUV = float2(-1.#INF, -1.#INF);
    float minZ = 1.#INF;
    float maxZ = -1.#INF;

    [unroll]
    for (int i = 0; i < 8; i++)
    {
        float3 cornerWorld = center + extents * offsets[i];
        float4 cornerClip = mul(_HiZ_VP, float4(cornerWorld, 1.0f));

        // If any corner is behind the camera, keep the instance visible.
        if (cornerClip.w <= 0.0f)
        {
            return false;
        }

        cornerClip.xyz /= cornerClip.w;

        float2 uv = cornerClip.xy * 0.5f + 0.5f;
        float depth = saturate(cornerClip.z);

        minUV = min(minUV, uv);
        maxUV = max(maxUV, uv);
        minZ = min(minZ, depth);
        maxZ = max(maxZ, depth);
    }

    if (maxUV.x < 0.0f || minUV.x > 1.0f || maxUV.y < 0.0f || minUV.y > 1.0f)
    {
        return true;
    }

    // Screen-edge intersections are prone to false occlusion because the
    // projected bounds get clipped to the viewport before sampling HiZ.
    // Keep them visible rather than over-culling at the borders.
    // if (minUV.x < 0.0f || maxUV.x > 1.0f || minUV.y < 0.0f || maxUV.y > 1.0f)
    // {
    //     return false;
    // }

    minUV = saturate(minUV);
    maxUV = saturate(maxUV);

    float2 boundsSize = maxUV - minUV;
    int mipmapLevel = CalculateMipmapLevel(minUV, boundsSize);
    int maxMip = (int)_HizTextureSize.z - 1;
    mipmapLevel = clamp(mipmapLevel - 1, 0, maxMip);

    int mipWidth = max(1, (int)_HizTextureSize.x >> mipmapLevel);
    int mipHeight = max(1, (int)_HizTextureSize.y >> mipmapLevel);
    float2 expand = float2(1.0f / mipWidth, 1.0f / mipHeight);

    minUV = saturate(minUV - expand);
    maxUV = saturate(maxUV + expand);
    float occluderDepth = GatherConservativeOccluderDepth(minUV, maxUV, mipmapLevel);

    float viewDistance = length(center - _CameraPosition);
    float ndcDepthBias = WorldSpaceToNdcDepthBias(viewDistance, _HizWorldSpaceBias);

    bool isOccluded;

    if (_HizReversedZ != 0)
    {
        isOccluded = (maxZ + ndcDepthBias) < occluderDepth;
    }
    else
    {
        isOccluded = (minZ - ndcDepthBias) > occluderDepth;
    }

    if (!isOccluded)
    {
        return false;
    }

    // Refine only high-risk coarse HiZ results against mip0 so narrow gaps
    // between occluders still keep visible instances alive without paying the
    // extra mip0 cost for every occluded candidate.
    if (ShouldRunMip0Refine(boundsSize, mipmapLevel) &&
        HasVisibleSampleAtMip0(minUV, maxUV, minZ, maxZ, ndcDepthBias))
    {
        return false;
    }

    return true;
}

[numthreads(64, 1, 1)]
void CullInstances(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint3 groupID : SV_GroupID,
    uint3 groupThreadID : SV_GroupThreadID,
    uint groupIndex : SV_GroupIndex)
{
    int chunkIndex = groupID.x;
    if (chunkIndex >= _ChunkCount)
    {
        return;
    }

    ChunkInfo chunk = _VisibleChunkInfos[chunkIndex];
    uint localInstanceIndex = groupID.y * 64 + groupThreadID.x;
    if (localInstanceIndex >= chunk.count)
    {
        return;
    }

    uint globalInstanceIndex = chunk.startIndex + localInstanceIndex;
    GrassInstanceData data = _AllInstances[globalInstanceIndex];
    float3 position = data.position;

    float3 boundsCenter = _BoundsCenterOS;
    boundsCenter.xz *= data.scale.x;
    boundsCenter.y *= data.scale.y;

    float c = cos(data.rotationY);
    float s = sin(data.rotationY);
    float3 centerOffsetWS;
    centerOffsetWS.x = boundsCenter.x * c - boundsCenter.z * s;
    centerOffsetWS.z = boundsCenter.x * s + boundsCenter.z * c;
    centerOffsetWS.y = boundsCenter.y;

    float3 center = position + centerOffsetWS;

    float halfWidth = max(0.05f, data.scale.x * _Extents.x);
    float halfDepth = max(0.05f, data.scale.x * _Extents.z);
    float halfHeight = max(0.1f, data.scale.y * _Extents.y);
    float3 extents = float3(halfWidth + 0.05f, halfHeight + 0.05f, halfDepth + 0.05f);

    if (FrustumTest(center, extents))
    {
        if (_EnableHiZCulling)
        {
            #if defined(_DEBUG_HIZ)
            InterlockedAdd(_DebugTestedCount[0], 1);
            #endif

            if (HiZOcclusionTest(center, extents))
            {
                #if defined(_DEBUG_HIZ)
                InterlockedAdd(_DebugCulledCount[0], 1);
                #endif
                return;
            }
        }

        _CulledVisibleInstances.Append(data);
        InterlockedAdd(_VisibleInstanceCount[0], 1u);
    }
}

[numthreads(64, 1, 1)]
void CullInstancesWithHiZ(
    uint3 dispatchThreadID : SV_DispatchThreadID,
    uint3 groupID : SV_GroupID,
    uint3 groupThreadID : SV_GroupThreadID,
    uint groupIndex : SV_GroupIndex)
{
    CullInstances(dispatchThreadID, groupID, groupThreadID, groupIndex);
}

[numthreads(64, 1, 1)]
void ClassifyVisibleInstances(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchThreadID.x;
    uint visibleCount = _VisibleInstanceCount[0];
    if (instanceIndex >= visibleCount)
    {
        return;
    }

    GrassInstanceData data = _CulledVisibleInstancesInput[instanceIndex];
    float distance = length(_CameraPosition - data.position);
    if (distance >= _LodDistanceRange.x && distance < _LodDistanceRange.y)
    {
        _VisibleInstances.Append(data);
        InterlockedAdd(_ArgsBuffer[1], 1u);
    }
}
