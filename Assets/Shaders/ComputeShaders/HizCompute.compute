#pragma kernel HizCull

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

StructuredBuffer<float4x4> InputMatrices;
RWStructuredBuffer<float4x4> OutputMatrices;

RWStructuredBuffer<uint> VisibilityFlags;
RWStructuredBuffer<uint> VisibleCount;

// 实例总数
int InstanceCount;

TEXTURE2D(_HizDepthTexture);
SAMPLER(sampler_HizDepthTexture);

float4x4 _V;
float4x4 _P;

void CalculateScreenBounds(
    float3 worldPos,
    float radius,
    out float2 minUV,
    out float2 maxUV,
    out float viewDepth,
    out float ndcDepth
)
{
    // 1. 转到视图空间
    float3 viewPos = mul(_V, float4(worldPos, 1.0)).xyz;
    viewDepth = -viewPos.z; // 正深度

    // 2. 转到裁剪空间
    float4 clipPos = mul(_P, float4(viewPos, 1.0));

    // 3. 转到 NDC → UV
    float3 ndc = clipPos.xyz / clipPos.w;
    float2 screenUV = ndc.xy * 0.5 + 0.5;
    ndcDepth = ndc.z;
    // 4. ✅ 正确计算 UV 空间半径
    // 投影矩阵的 [0][0] 和 [1][1] 包含 FOV 和 aspect 信息
    float ndcRadiusX = (radius * _P[0][0]) / viewDepth;
    float ndcRadiusY = (radius * _P[1][1]) / viewDepth;
    
    // 转为 UV 空间半径（NDC 范围 [-1,1] → UV 范围 [0,1]，所以 *0.5）
    float2 uvRadius = float2(ndcRadiusX, ndcRadiusY) * 0.5;

    // 5. 计算边界（不建议钳制，除非必要）
    minUV = screenUV - uvRadius;
    maxUV = screenUV + uvRadius;

    // 可选：钳制（但会丢失屏幕外信息）
    // minUV = clamp(minUV, 0.0, 1.0);
    // maxUV = clamp(maxUV, 0.0, 1.0);
}

bool IsOccludedByHiz(float3 worldPos,float radius)
{
    float2 minUV,maxUV;
    float viewDepth;
    float ndcDepth;
    CalculateScreenBounds(worldPos,radius,minUV,maxUV,viewDepth,ndcDepth);

    float2 boundSize = maxUV - minUV;
    float maxSize = max(boundSize.x,boundSize.y);

    const int2 offsetsUv[] = {
        int2(0,0),
        int2(0,1),
        int2(1,0),
        int2(1,1)
    };

    int mipmaplevel = 0;
    if (maxSize <= 0.5) mipmaplevel = 9;
    if (maxSize <= 0.25) mipmaplevel = 8;
    if (maxSize <= 0.125) mipmaplevel = 7;
    if (maxSize <= 0.0625) mipmaplevel = 6;
    if (maxSize <= 0.03125) mipmaplevel = 5;
    if (maxSize <= 0.015625) mipmaplevel = 4;
    if (maxSize <= 0.0078125) mipmaplevel = 3;
    if (maxSize <= 0.00390625) mipmaplevel = 2;
    if (maxSize <= 0.001953125) mipmaplevel = 1;
    
    float maxDepth = 0.5;
    for(int i = 0; i < 4; i++)
    {
        float2 uv = lerp(minUV , maxUV,offsetsUv[i]) * 1024.0;
        uint2 realUV = uint2(uv) >> mipmaplevel;
        float depth = _HizDepthTexture.Load(uint3(realUV,mipmaplevel));
        maxDepth = max(depth,maxDepth);
    }
    return maxDepth > ndcDepth;
}


void Process(uint3 id)
{
    if(id.x == 0)
    {
        VisibleCount[0] = 0;
    }
    GroupMemoryBarrierWithGroupSync();
    if(id.x >= InstanceCount)
    {
        return;
    }
    float4x4 matrix_x4 = InputMatrices[id.x];
    //float3 position = float3(matrix_x4[0][3], matrix_x4[1][3], matrix_x4[2][3]);
    float3 worldPos = float3(matrix_x4._m03_m13_m23);
    float radius = 2;
    bool hizCulled = IsOccludedByHiz(worldPos,radius);

    if (!hizCulled)
    {
        // 使用原子操作确保顺序写入
        uint outputIndex;
        InterlockedAdd(VisibleCount[0], 1, outputIndex);
        
        // 按顺序写入输出缓冲区
        OutputMatrices[outputIndex] = matrix_x4;
    }
}

//
[numthreads(64, 1, 1)]
void HizCull(uint3 id : SV_DispatchThreadID)
{
    Process(id.x);
}